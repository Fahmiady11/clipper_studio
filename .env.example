# ─── Aplikasi ────────────────────────────────────────────────────────────
APP_NAME="Clipper Studio"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
# URL publik aplikasi (mis. URL ngrok). Dipakai untuk link & redirect TikTok.
APP_URL=http://localhost:8080

# ─── Database (PostgreSQL) ───────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=clipper
DB_USERNAME=postgres
DB_PASSWORD=

# Session, antrian job, dan cache disimpan di database (aman untuk beberapa worker)
# true kalau dibuka lewat HTTPS (ngrok/cloudflared/domain sendiri)
SESSION_SECURE_COOKIE=false
# Pendaftaran akun baru: false = hanya akun pertama (pemilik) yang bisa daftar
REGISTRATION_ENABLED=false
# Email shown on /terms and /privacy for questions and data requests
CONTACT_EMAIL=
SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

# ─── AI ──────────────────────────────────────────────────────────────────
# Gateway OpenAI-compatible (OmniRoute), dicoba paling dulu. Kosongkan untuk tidak dipakai.
# MODEL boleh beberapa, dipisah koma = urutan cadangan.
# contoh: https://omniroute.example.com/v1
LLM_GATEWAY_URL=
LLM_GATEWAY_KEY=
LLM_GATEWAY_MODEL=
# contoh: agy/gemini-3.1-pro-low,agy/gemini-3.7-flash-medium

# Gemini API (aistudio.google.com/apikey) — cadangan kalau gateway gagal
GEMINI_API_KEY=
# GEMINI_MODELS=gemini-2.5-flash,gemini-3.5-flash,gemini-2.5-flash-lite,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-lite-latest

# Groq (console.groq.com) — Whisper, untuk transkrip video tanpa subtitle YouTube
GROQ_API_KEY=

# ─── yt-dlp (download YouTube) ───────────────────────────────────────────
# Cookies mengatasi "Sign in to confirm you're not a bot". Isi salah satu;
# browser lebih disarankan (selalu segar). Browser dipakai kalau keduanya diisi.
YTDLP_COOKIES_BROWSER=chrome
YTDLP_COOKIES=
# YTDLP_PATH=yt-dlp
# FFMPEG_PATH=ffmpeg
# Reframe yang mengikuti wajah: python dengan opencv-python-headless + numpy.
# Kosongkan untuk crop tengah saja. Image Docker sudah mengisi ini sendiri.
#   python3 -m venv ~/.local/share/clipper-facetrack
#   ~/.local/share/clipper-facetrack/bin/pip install opencv-python-headless==4.10.0.84 numpy==1.26.4
# FACE_TRACK_PYTHON=python3

# ─── TikTok (developers.tiktok.com → app kamu) ───────────────────────────
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Harus sama persis dengan Redirect URI di app TikTok: <APP_URL>/tiktok/callback
TIKTOK_REDIRECT_URI=https://your-tunnel.example.com/tiktok/callback
# Tambah video.publish untuk posting langsung (aktifkan dulu di app TikTok)
TIKTOK_SCOPES=user.info.basic,video.upload

# ─── Lain-lain (opsional) ────────────────────────────────────────────────
# Library musik latar: <path>/<mood>/*.mp3 (default storage/app/music)
# MUSIC_LIBRARY_PATH=
# Video sumber yang sudah diunduh dihapus setelah sekian jam (job harian)
# CLIPPER_TEMP_RETENTION_HOURS=72
